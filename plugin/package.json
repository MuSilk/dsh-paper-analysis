{
  "name": "dsh-paper",
  "version": "0.1.0",
  "description": "从 arXiv 选一篇还没写过的论文，并把解读写入站点仓库的月份目录。不操作 git。",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness"],
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "paper.config.json"
  ],
  "scripts": {
    "test": "node --test src/publish.test.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.1": "compatible",
        "0.2.0-rc.2": "compatible"
      }
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1"
  }
}
